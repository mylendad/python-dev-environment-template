{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "disabled": false
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "semble[mcp]==0.5.5",
        "semble"
      ],
      "enabled": true
    }
  }
}
